export default "edd 1.0\nmeta { title: \"Visualizations\" }\n\n// 62 chart & diagram templates ship built-in — declare DATA, get a diagram.\n// The default look is the black-and-white hand-drawn Classic. Add a style to\n// restyle everything, e.g. `meta { style: classic-color }` — also colorful-lines,\n// chalkboard, crayon, earthy-gradient, mono-accent, fine-line, neutral-lines.\n// Full catalog: Docs → Visualizations.\n\nviz funnel sales \"Sales Funnel\" {\n  input: \"Potential customers\"\n  output: \"Closed deals\"\n  item \"Awareness\" 5000\n  item \"Interest\" 1800 \"Warm leads in the CRM\"\n  item \"Evaluation\" 420\n  item \"Won\" 38 { icon: trophy }\n}\n\nviz venn \"Product Sweet Spot\" {\n  set \"Desirable\" \"What users want\" { icon: heart }\n  set \"Feasible\" \"What we can build\" { icon: gear }\n  set \"Viable\" \"What sustains us\" { icon: dollar }\n  overlap all \"Great products\"\n}\n\nviz cycle \"Build-Measure-Learn\" {\n  item \"Build\" \"Ship the smallest useful slice\" { icon: gear }\n  item \"Measure\" \"Watch real usage, not opinions\" { icon: chart }\n  item \"Learn\" \"Decide: persevere or pivot\" { icon: bulb }\n}\n\n// Viz elements are ordinary scene elements: annotate them, focus them, edit them.\nannotate {\n  circle-mark sales.won \"the goal\"\n}\n\ntimeline {\n  beat all \"Everything\" { camera fit-all }\n  beat funnel \"The funnel\" { camera focus sales.won zoom 1.6 }\n}\n"